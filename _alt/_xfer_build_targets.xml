    <!--
        Phase 1: Isolationsprüfung der Element-Packages (Paketvertrag Punkt 9). Jedes Package unter src/com/dan
        außer der App wird für sich allein übersetzt: Kern nur gegen das JDK, gl/ gegen JOGL, demo/ gegen FStyle.
        Läuft nach jedem Übersetzen; abschalten mit -Dohne.paketpruefung=true.
    -->
    <target name="check-packages" description="Übersetzt jedes Element-Package einzeln gegen JDK, JOGL und FStyle." unless="ohne.paketpruefung">
        <property name="platform.java" value="java"/>
        <exec executable="${platform.java}" dir="${basedir}" failonerror="true">
            <arg value="-Dstdout.encoding=UTF-8"/>
            <arg value="-Dstderr.encoding=UTF-8"/>
            <arg value="tools/PaketPruefung.java"/>
            <arg value="src"/>
            <arg value="lib"/>
        </exec>
    </target>
    <target name="-post-compile" depends="check-packages"/>

    <!-- Phase 1: Prüfprogramm der App ohne Grafikkarte und Datenbank (endet mit "ERGEBNIS: alles in Ordnung"). -->
    <target name="pruefung" depends="compile-test" description="Startet die Prüfung com.dan.glacier.test.Pruefung.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.glacier.test.Pruefung" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <classpath><pathelement path="${run.test.classpath}"/></classpath>
        </java>
    </target>

</project>
